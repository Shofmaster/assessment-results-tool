{
  "//": "framework + outputDirectory are pinned rather than auto-detected. Vercel infers the framework from dependencies, and taking react-router 8 (which dropped the react-router-dom package) made it detect a React Router framework app, which builds to build/ instead of Vite's dist/. The build succeeded and the deploy still failed on the missing directory. This app is a Vite SPA that happens to use react-router as a library, so say so explicitly.",
  "framework": "vite",
  "outputDirectory": "dist",
  "functions": {
    "api/claude.ts": {
      "maxDuration": 300
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "aerogap.com"
        }
      ],
      "destination": "https://www.aerogaptechnologies.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.aerogap.com"
        }
      ],
      "destination": "https://www.aerogaptechnologies.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "aerogaptechnologies.com"
        }
      ],
      "destination": "https://www.aerogaptechnologies.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), display-capture=(self)"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noai, noimageai"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
