# Real deployment config. Contains the Anthropic key, Clerk secret, and the
# Convex instance secret. Never commit — .env.example is the tracked template.
.env
.env.local
.env.*.local

# Build output
dist/
node_modules/

# Operator-supplied TLS material for the proxy.
proxy/certs/*
!proxy/certs/.gitkeep

# Backup archives produced by scripts/backup.mjs
backups/
*.tar.gz

# Windows installer build output (large binaries; built by build-staging.ps1).
# Output is the latest compile only. Retained installers live in
# %LOCALAPPDATA%\AeroGapBuildCache\desktop-releases — see docs/DESKTOP-ROLLBACK.md.
windows/Output/

# In-repo release archive if -ReleaseArchive is pointed here. Do not commit exes.
windows/releases/
