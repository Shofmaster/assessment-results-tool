# Real deployment config. Contains the Anthropic key, Clerk secret, and the
# Convex instance secret. Never commit — .env.example is the tracked template.
.env
.env.local
.env.*.local

# Build output
dist/
node_modules/

# Operator-supplied TLS material for the proxy.
proxy/certs/*
!proxy/certs/.gitkeep

# Backup archives produced by scripts/backup.mjs
backups/
*.tar.gz

# Windows installer build output (large binaries; built by build-staging.ps1).
# Not a retention store: the next same-version compile replaces the exe here.
windows/Output/

# Prior desktop installers kept for manual rollback. Binaries and the local
# manifest stay on the build machine; README.md is the operator note and is tracked.
# See docs/DESKTOP-ROLLBACK.md.
windows/installer-archive/*
!windows/installer-archive/README.md
