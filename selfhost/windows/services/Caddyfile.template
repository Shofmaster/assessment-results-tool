# =============================================================================
# AeroGap reverse proxy - generated by install.ps1 from this template.
# =============================================================================
# Do not edit the generated copy in Program Files; edit this template and re-run
# the installer, or an upgrade will silently revert your change.
#
# WHY A PROXY IS REQUIRED, NOT OPTIONAL
# The Convex backend has no native TLS support (verified: no cert/key flags),
# and the browser connects to it DIRECTLY. So an https application page making
# http Convex calls is blocked as mixed content, and the app loads and then
# hangs. Something has to terminate TLS in front of both, and that is this.
#
# It also closes an exposure: without it the Convex backend binds 0.0.0.0 and is
# reachable from anywhere on the network. Behind this proxy both backends bind
# loopback only, and this is the single front door.
#
# PORTS
#   public 443   -> app     (127.0.0.1:{{APP_INTERNAL_PORT}})
#   public 3210  -> convex  (127.0.0.1:{{CONVEX_INTERNAL_PORT}})
#   public 3211  -> convex HTTP actions (127.0.0.1:{{CONVEX_SITE_INTERNAL_PORT}})
#
# The public Convex ports keep their familiar numbers so the URLs stay
# recognisable; only the internal bindings moved.
# =============================================================================

{
	# No public ACME endpoint is reachable from most internal networks, and
	# leaving the default on produces slow, confusing startup failures.
	auto_https disable_redirects
	admin off
}

(aerogap_headers) {
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Never advertise the proxy version to clients.
		-Server
	}
}

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
https://{{APP_DOMAIN}} {
	{{TLS_DIRECTIVE}}
	import aerogap_headers
	# X-Frame-Options DENY only on the app: it must not be framed. It is omitted
	# from the Convex sites, which are APIs, not documents.
	header X-Frame-Options "DENY"

	encode zstd gzip

	reverse_proxy 127.0.0.1:{{APP_INTERNAL_PORT}} {
		# AI analysis runs long - api/claude is allowed 300s. A shorter timeout
		# severs streaming responses mid-answer, which surfaces to the user as a
		# truncated reply rather than an error.
		transport http {
			read_timeout 310s
			write_timeout 310s
		}
		# Server-Sent Events must not be buffered, or the response arrives in one
		# lump at the end instead of streaming.
		flush_interval -1
	}

	log {
		output file "{{LOG_DIR}}\proxy-app.log" {
			roll_size 10MiB
			roll_keep 14
		}
		# Request URLs carry document paths and identifiers. Keep the volume low
		# and let the application own its own audit logging.
		level WARN
	}
}

# -----------------------------------------------------------------------------
# Convex backend - the browser connects here directly (websockets + HTTP)
# -----------------------------------------------------------------------------
https://{{APP_DOMAIN}}:3210 {
	{{TLS_DIRECTIVE}}
	import aerogap_headers

	reverse_proxy 127.0.0.1:{{CONVEX_INTERNAL_PORT}} {
		# Convex holds a long-lived websocket for live queries. Without generous
		# timeouts the connection is torn down every few minutes and the UI
		# silently stops updating.
		transport http {
			read_timeout 3600s
			write_timeout 3600s
		}
		flush_interval -1
	}

	log {
		output file "{{LOG_DIR}}\proxy-convex.log" {
			roll_size 10MiB
			roll_keep 14
		}
		level WARN
	}
}

# -----------------------------------------------------------------------------
# Convex HTTP actions (webhook endpoints)
# -----------------------------------------------------------------------------
https://{{APP_DOMAIN}}:3211 {
	{{TLS_DIRECTIVE}}
	import aerogap_headers

	reverse_proxy 127.0.0.1:{{CONVEX_SITE_INTERNAL_PORT}} {
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}

	log {
		output file "{{LOG_DIR}}\proxy-convex-site.log" {
			roll_size 10MiB
			roll_keep 14
		}
		level WARN
	}
}
