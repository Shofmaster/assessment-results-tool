# ============================================================================
# AeroGap Self-Hosted - deployment configuration
# ============================================================================
# Copy to `.env` and fill in. `npm run doctor` validates this file before and
# after bring-up; run it whenever you change anything here.
#
# Every value marked REQUIRED must be set or the stack refuses to start. We fail
# closed on purpose: a half-configured auth or approval check is worse than a
# stack that will not boot.
# ============================================================================


# ---------------------------------------------------------------------------
# 1. Where this install lives
# ---------------------------------------------------------------------------
# REQUIRED. The URL your users type. Must match the TLS certificate served by
# the proxy, and must be reachable from user browsers on your network.
# No trailing slash, no path.
APP_ORIGIN=https://aerogap.example.internal

# Extra browser origins allowed to call the API (comma-separated). Most installs
# leave this empty. Use it if you front the app with an additional hostname or a
# split-horizon DNS alias.
ALLOWED_ORIGINS=

# Port the app container listens on behind the proxy. Change only if 8080 is
# already taken inside your container network.
APP_PORT=8080

# --- Hostnames the reverse proxy serves ---
# These are the bare hostnames (no scheme) matching the URLs above. All three
# must resolve to this host on your internal DNS, and ALL THREE must be
# reachable from user browsers: the frontend connects to the Convex hostname
# directly, so proxying only the app hostname yields an app that loads and then
# hangs with no visible error.
APP_DOMAIN=aerogap.example.internal
CONVEX_DOMAIN=convex.example.internal
CONVEX_SITE_DOMAIN=convex-site.example.internal

# Ports the proxy binds on the host. Change if something already owns 80/443.
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443


# ---------------------------------------------------------------------------
# 2. Convex backend (self-hosted - runs in this stack, no cloud involved)
# ---------------------------------------------------------------------------
# REQUIRED. Identifies this deployment AND names its database.
#
# The Convex backend derives its Postgres database name from this value with
# dashes replaced by underscores. Use underscores here so the two are identical
# and there is nothing to get out of step - `npm run doctor` enforces this.
# Changing it after first boot points the backend at a different, empty database.
CONVEX_INSTANCE_NAME=aerogap_onprem

# REQUIRED. Signing secret for the Convex backend. Generate ONCE with:
#   openssl rand -hex 32
# Changing this after first boot invalidates existing data access. Back it up
# with your database backups - losing it means losing the deployment.
CONVEX_INSTANCE_SECRET=

# URLs the Convex backend advertises. CONVEX_PUBLIC_URL must be reachable from
# user BROWSERS (it is baked into the frontend bundle at build time).
# CONVEX_SITE_URL serves Convex HTTP actions (webhooks).
CONVEX_PUBLIC_URL=https://convex.example.internal
CONVEX_SITE_URL=https://convex-site.example.internal

# Admin key for deploying functions into the self-hosted backend. Generated on
# first boot by `npm run bootstrap` - leave blank initially.
CONVEX_SELF_HOSTED_ADMIN_KEY=

# REQUIRED. Password for the bundled Postgres container. Generate with:
#   openssl rand -base64 24
# Avoid characters that need URL-escaping (@ : / ?) - it also appears inside
# CONVEX_POSTGRES_URL below. Must match that value.
POSTGRES_PASSWORD=

# REQUIRED. Postgres connection for Convex persistence.
#
# NOTE THE MISSING DATABASE NAME - that is deliberate and required. This URL
# addresses the Postgres SERVER; the backend picks the database itself from
# CONVEX_INSTANCE_NAME. Appending "/dbname" here breaks startup.
#
# Point this at your own managed Postgres instead if you have one - recommended
# for production, since you likely already have backup and HA for it. If you do,
# create the database named by CONVEX_INSTANCE_NAME first, and remove
# DO_NOT_REQUIRE_SSL from the convex service in docker-compose.yml.
CONVEX_POSTGRES_URL=postgresql://convex:CHANGE_ME@postgres:5432


# ---------------------------------------------------------------------------
# 3. Identity / authentication
# ---------------------------------------------------------------------------
# AUTH_MODE selects how users sign in:
#   clerk - Clerk-hosted identity. Simplest for server installs with a real
#           hostname, but sign-in traffic leaves your network.
#   local - This install issues its own identities (desktop and air-gapped).
#   oidc  - Your own identity provider (Entra ID, Okta, Keycloak). NOT YET
#           IMPLEMENTED — the server refuses to start if you set this.
#
# Read docs/AUTH.md before choosing.
AUTH_MODE=clerk

# --- AUTH_MODE=clerk ---
# REQUIRED when AUTH_MODE=clerk.
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
# Clerk JWT issuer domain, e.g. clerk.yourcompany.com (no https://, no slash).
CLERK_JWT_ISSUER_DOMAIN=
# JWT template audience. Leave as "convex" unless you renamed the template.
CLERK_JWT_AUDIENCE=convex
# Optional: signing secret for Clerk to app user-sync webhooks.
CLERK_WEBHOOK_SECRET=

# --- AUTH_MODE=local ---
# Desktop installs set AUTH_MODE=local automatically. For server installs, set
# AUTH_MODE=local and APP_ORIGIN to the URL users open. LOCAL_AUTH_ISSUER and
# LOCAL_AUTH_JWKS_URL are derived from APP_ORIGIN at boot and pushed to Convex
# during bootstrap — you do not configure them by hand.
#
# --- AUTH_MODE=oidc (not implemented) ---
# REQUIRED when AUTH_MODE=oidc. Discovery URL of your IdP, e.g.
#   https://login.microsoftonline.com/<tenant>/v2.0/.well-known/openid-configuration
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Claim carrying the email address. Entra ID commonly uses preferred_username.
OIDC_EMAIL_CLAIM=email


# ---------------------------------------------------------------------------
# 4. AI providers  (the one unavoidable outbound dependency)
# ---------------------------------------------------------------------------
# OPTIONAL. AI provider keys are normally added IN THE APP, not here: sign in as
# an administrator and open Settings > AI Keys. They are stored in Convex per
# company, so every member of a company inherits one key and the customer bills
# their own provider account. That is also the only way to rotate a key without
# an elevated shell on this machine.
#
# A key set here is the deployment-wide FALLBACK, used by anyone with no company
# key of their own. On a single-organisation install you may prefer to set the
# install-wide default in the app instead and leave these blank.
#
# WHAT LEAVES YOUR NETWORK: the prompt text and any document excerpts retrieved
# for that specific request. Whole documents are not uploaded; your corpus stays
# in the Convex volume on this stack. See docs/DATA-FLOW.md for a diagram you
# can hand to a security reviewer.
ANTHROPIC_API_KEY=

# Optional. Enables the OpenAI provider path in the model picker.
OPENAI_API_KEY=

# REQUIRED. Shared secret that lets the app tier ask Convex which key to use for
# a given company. The SAME value must exist here and in the Convex backend;
# bootstrap.mjs generates one and pushes it to both if this is blank. On Windows
# install.ps1 has already written one, because the app service refuses to start
# without it.
AI_CREDENTIAL_SERVICE_TOKEN=

# Where Convex serves HTTP actions, reached DIRECTLY rather than through the TLS
# proxy. Docker: http://convex:3211. Windows: http://127.0.0.1:13211 - the
# backend's loopback port, NOT the public 3211 that Caddy owns.
CONVEX_SITE_INTERNAL_URL=

# --- Embeddings (semantic search over your manuals) ---
# voyage | openai. Deployment-wide, and it cannot vary per company: the vector
# index is built at a fixed dimension, so mixing providers would put different
# embedding spaces in one index. Only the KEY is per-company.
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-3-lite
VOYAGE_RERANK_MODEL=rerank-2-lite
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Route AI traffic through your own egress proxy or gateway. Leave blank to call
# the vendor APIs directly. Set this if your network requires outbound traffic to
# pass an inspection proxy.
#
# Form: http://proxy.example.internal:3128  (http/https only; SOCKS is not
# supported and the app refuses to start rather than bypassing it silently).
#
# YOUR PROXY MUST ALLOW THE CONNECT METHOD to api.anthropic.com:443 and
# api.voyageai.com:443. Outbound requests are tunnelled, not forwarded as
# absolute-URI GETs, so a proxy that permits ordinary HTTP but denies CONNECT
# will make requests hang rather than fail cleanly.
#
# Stack-internal traffic (convex, postgres) always bypasses the proxy — compose
# sets NO_PROXY for you.
AI_HTTPS_PROXY=


# ---------------------------------------------------------------------------
# 5. Telemetry - OFF by default on self-hosted installs
# ---------------------------------------------------------------------------
# Deliberately blank. The hosted product reports errors and product analytics to
# Sentry and PostHog; a self-hosted install sends NOTHING unless you fill these
# in. Leaving them blank is the supported configuration.
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=


# ---------------------------------------------------------------------------
# 6. Optional integrations
# ---------------------------------------------------------------------------
# --- Outbound email (approval notices, AD/SB alerts) ---
# Leave blank to disable email entirely; the app degrades gracefully and shows
# notifications in-app only. Most on-prem installs use their own SMTP relay.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=aerogap@example.internal
ADMIN_NOTIFY_EMAIL=

# --- Google Drive document linking ---
# Optional. Only needed if your users link manuals from Google Drive. Most
# on-prem installs use the internal file-server source instead (section 7) and
# leave this off.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Billing ---
# Self-hosted installs are site-licensed, not per-seat metered. Leave disabled.
BILLING_ENFORCEMENT_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=


# ---------------------------------------------------------------------------
# 7. Internal document sources
# ---------------------------------------------------------------------------
# The reason most customers self-host. The proxy reverse-proxies your internal
# manual server under this app's own origin, which removes the browser CORS and
# mixed-content restrictions that block this in the hosted product.
#
# Example: DOC_SERVER_UPSTREAM=http://manuals.example.internal
# Manuals are then reachable to the app at {APP_ORIGIN}/docsrv/... over HTTPS,
# same-origin, with no changes required on the file server itself.
DOC_SERVER_UPSTREAM=
